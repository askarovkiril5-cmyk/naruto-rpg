@echo off
chcp 65001 >nul
title Naruto RPG - Онлайн Туннель для Друзей
cls

echo ===================================================================
echo     ⚡ NARUTO RPG: МГНОВЕННЫЙ ОНЛАЙН ДЛЯ ДРУЗЕЙ (БЕЗ VPN)
echo ===================================================================
echo.
echo [1/2] Проверка локального сервера игры...
curl -s http://localhost:4000/api/rules/versions >nul 2>&1
if %ERRORLEVEL% NEQ 0 (
    echo [..] Сервер ещё не запущен. Запускаем локальный сервер в фоне...
    start "Naruto RPG Server" /d "%~dp0server" node index.js
    timeout /t 3 /nobreak >nul
) else (
    echo [OK] Локальный сервер на порту 4000 уже работает!
)

echo.
echo [2/2] Создание защищённого публичного HTTPS-туннеля...
echo.
echo -------------------------------------------------------------------
echo 📢 ВНИМАНИЕ: Сейчас ниже появится публичная ссылка (URL).
echo 👉 Скопируй её и отправь другу (Кириллу)!
echo 📱 Друг сможет открыть её в браузере (на ПК или телефоне) и сразу играть!
echo -------------------------------------------------------------------
echo.

npx.cmd --yes localtunnel --port 4000
pause
