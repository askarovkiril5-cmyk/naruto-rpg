# ===============================================
# Naruto RPG Server - Переменные окружения (.env)
# ===============================================

# Порт Express сервера
PORT=4000

# Режим окружения: development / production
NODE_ENV=development

# Путь к директории постоянного хранилища (сохранения боев и пользователей)
DATA_DIR=./data

# Ключ Google AI Studio (Gemini API)
# Получить бесплатно: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# Флагманская модель по умолчанию (gemini-2.5-pro / gemini-1.5-pro / gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-pro

# (Опционально) Ключ OpenAI API для резервного режима (gpt-4o / gpt-4o-mini)
OPENAI_API_KEY=

# (Опционально) Google OAuth 2.0 Client ID для авторизации в Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
